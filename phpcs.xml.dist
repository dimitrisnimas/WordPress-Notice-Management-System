<?xml version="1.0"?>
<ruleset name="WordPress Notice Management System">
    <description>WordPress Coding Standards for both plugins and their tests.</description>

    <file>admin-notice-manager</file>
    <file>client-notice-receiver</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/wordpress-develop/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="extensions" value="php"/>

    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress-Core"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="admin-notice-manager"/>
                <element value="client-notice-receiver"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>*/admin-notice-plugin.php</exclude-pattern>
        <exclude-pattern>*/client-notice-plugin.php</exclude-pattern>
        <exclude-pattern>*/tests/test-*.php</exclude-pattern>
    </rule>
</ruleset>
